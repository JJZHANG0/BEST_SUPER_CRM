# Local development for the NEXUS API (copy to .env; never commit real secrets).
# Start PostgreSQL with `docker compose up -d db` (see docker-compose.yml) or use a local install.
DATABASE_URL=postgres://nexus:nexus@127.0.0.1:5432/nexus_local
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXUS_ENV=local
HOST=127.0.0.1
PORT=3001
# Allow the Next dev server to call the API directly (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (build time). Leave NEXT_PUBLIC_API_BASE empty for the static demo / GitHub Pages build.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001/api
# NEXT_PUBLIC_NEXUS_ENV=development
